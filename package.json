{
  "name": "synapse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:unit": "bun test test/unit/",
    "test:integration": "bun test test/integration/",
    "test:e2e": "bun test test/e2e/",
    "viewer": "bun run src/viewer/server.ts",
    "agent": "bun run src/agent/main.ts",
    "setup": "bun run src/setup.ts",
    "viewer:dev": "cd src/viewer/web && vite dev",
    "viewer:build": "cd src/viewer/web && vite build",
    "viewer:check": "cd src/viewer/web && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@lucide/svelte": "^1.34.0",
    "bits-ui": "^1.0.0",
    "bun": "^1.4.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.5.0",
    "tailwind-variants": "^0.3.0",
    "uuid": "^14.0.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "^1.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0"
  }
}
